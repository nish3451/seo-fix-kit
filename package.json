{
  "name": "seo-fix-kit",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:cf": "wrangler dev --remote",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "test:audit": "node server/audit/smoke-test.js",
    "check": "npm run test:audit && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "cheerio": "^1.1.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "wrangler": "^4.93.0"
  },
  "overrides": {
    "ws": "^8.20.1"
  }
}
