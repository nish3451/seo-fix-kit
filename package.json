{
  "name": "seo-fix-kit",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node server/index.js",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:cf": "wrangler dev --remote",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "ops:audit-owned": "node scripts/run-live-audit-batch.mjs",
    "test:billing": "node server/dodo-payment-smoke-test.js",
    "test:product-truth": "node server/product-truth-smoke-test.js",
    "test:audit": "node server/audit/smoke-test.js",
    "test:large-crawl-security": "node server/large-crawl-security-smoke-test.js",
    "test:report-retention-security": "node server/report-retention-security-smoke-test.js",
    "test:local-developer-api-security": "node server/local-developer-api-security-smoke-test.js",
    "test:remediation-brief": "node server/remediation-brief-smoke-test.js",
    "test:audit-batch-runner": "node --test scripts/run-live-audit-batch.test.mjs",
    "test:webhooks": "node --test worker/lib/webhooks.test.mjs",
    "test:large-crawl": "node server/large-rendered-crawl-smoke-test.js",
    "check": "npm run test:billing && npm run test:product-truth && npm run test:audit && npm run test:large-crawl-security && npm run test:report-retention-security && npm run test:local-developer-api-security && npm run test:remediation-brief && npm run test:audit-batch-runner && npm run test:webhooks && npm run test:large-crawl && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "cheerio": "^1.1.2",
    "concurrently": "10.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "esbuild": "0.28.1",
    "wrangler": "^4.102.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "^8.20.1"
  }
}
